%# Shared preamble. Include AFTER setting `use_color` and `fontsize` in the
%# child template. Page geometry is deliberately NOT here: the variants differ.
\documentclass[\VAR{ fontsize },a4paper]{article}

\usepackage{fontspec}
\usepackage{polyglossia}
\setmainlanguage{\VAR{ 'polish' if doc.lang == 'pl' else 'english' }}

\setmainfont{TeX Gyre Heros}
\setsansfont{TeX Gyre Heros}
\newfontfamily\headingfont{TeX Gyre Heros}

\usepackage{xcolor}
\BLOCK{ if use_color }
\definecolor{accent}{HTML}{\VAR{ doc.accent_hex }}
\BLOCK{ else }
\definecolor{accent}{HTML}{000000}
\BLOCK{ endif }
\definecolor{muted}{HTML}{555555}

%# Spacing is tuned so a realistic CV — around 3 roles, 8-10 bullets, education,
%# a few certificates and skills — lands on one page. Loosen these and the
%# model has to cut real content to fit, which is the wrong trade.
\usepackage{enumitem}
\setlist[itemize]{leftmargin=1.0em, itemsep=0.04em, topsep=0.12em, parsep=0pt,
                  partopsep=0pt, label=\textbullet}

\usepackage{titlesec}
\titleformat{\section}
  {\large\bfseries\color{accent}}{}{0pt}{}
  [\vspace{-0.5em}{\color{accent}\rule{\linewidth}{0.7pt}}]
\titlespacing*{\section}{0pt}{0.75em}{0.3em}

\usepackage{needspace}
%# Page-break guards. LaTeX will happily strand a section heading or a job title
%# at the foot of a page; these force the break one entry earlier instead.
%# Always use \cvsection and \entrybreak rather than bare \section*.
\newcommand{\cvsection}[1]{\needspace{6\baselineskip}\section*{#1}}
\newcommand{\entrybreak}{\needspace{4\baselineskip}}

\usepackage[hidelinks]{hyperref}
\hypersetup{
  pdftitle={\VAR{ doc.full_name } — CV},
  pdfauthor={\VAR{ doc.full_name }},
  pdfsubject={\VAR{ doc.headline }},
}
\BLOCK{ if use_color }
\hypersetup{colorlinks=true, urlcolor=accent, linkcolor=accent}
\BLOCK{ endif }

\pagestyle{empty}
\setlength{\parindent}{0pt}
